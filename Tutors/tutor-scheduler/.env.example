# База данных — PostgreSQL.
# Локально:  postgresql://postgres:postgres@localhost:5432/tutor_scheduler?schema=public
# На сервере (self-hosted Postgres на том же VPS):
DATABASE_URL="postgresql://tutor:СМЕНИ_ПАРОЛЬ@localhost:5432/tutor_scheduler?schema=public"

# Секрет для подписи сессионных JWT-cookie. Сгенерируй: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-long-random-string"

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=""

# Username бота без @ (нужен для формирования ссылок-приглашений t.me/<bot>?start=...)
NEXT_PUBLIC_BOT_USERNAME="your_bot_username"

# Chat_id администратора для уведомлений (новая регистрация / привязка Telegram).
# Как узнать: напишите боту команду /id — он пришлёт ваш chat_id. Оставьте пустым, чтобы отключить.
ADMIN_TELEGRAM_CHAT_ID="1979818195"

# Базовый URL приложения (для webhook в проде)
APP_URL="http://localhost:3000"

# Секрет для защиты cron-роута /api/cron/reminders
CRON_SECRET="change-me-cron-secret"

# --- Бэкапы БД в объектное хранилище (S3, Timeweb Cloud) ---
# Используются скриптом scripts/backup-db.sh. Не нужны самому приложению.
# Можно держать в отдельном файле /etc/tutor-backup.env (см. DEPLOY.md).
# S3_BUCKET=""
# S3_ENDPOINT="https://s3.twcstorage.ru"   # уточните endpoint в панели Timeweb
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
